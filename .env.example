# Скопируйте в .env.local (локально) или задайте в Vercel → Project → Settings → Environment Variables.
# Значения возьмите в Supabase: Project Settings → API.
# Пошаговая настройка БД, Storage и Auth: см. supabase/README.md

# Публичные (доступны в браузере) — для входа в админку и клиента Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Только сервер (НЕ добавляйте префикс NEXT_PUBLIC_) — для API админки, записи в БД и Storage.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Vercel: все три переменные выше — в scope Production; URL только *.supabase.co. После смены NEXT_PUBLIC_* — Redeploy без build cache.
# Проверка: GET /api/admin/diagnostics/env (должен вернуть JSON, не 404).

# Для автонастройки: npm run supabase:bootstrap
# Supabase → Settings → Database → Connection string → URI (лучше Direct, порт 5432).
# DATABASE_URL=postgresql://postgres.xxx:ВАШ_ПАРОЛЬ@db.xxx.supabase.co:5432/postgres
# Опционально — сразу создать вход в админку:
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=secure-password-here

# Канонический URL сайта (SEO, ссылки). На Спринтхост / REG.RU:
# NEXT_PUBLIC_SITE_URL=https://www.gdefazan.ru

# Аварийный вход в /admin без Supabase Auth (кнопка на странице логина). Только на VPS при сломанных ключах:
# ENABLE_DEMO_ADMIN=1
